DATABASE_URL="postgresql://arven:CHANGE_DB_PASSWORD@db:5432/arven"
POSTGRES_DB=arven
POSTGRES_USER=arven
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
PORT=3000
NODE_ENV=production
APP_URL=https://YOUR-DOMAIN.example
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@YOUR-DOMAIN.example
ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_PASSWORD_12PLUS_CHARS

# Telegram notifications (optional). Create a NEW bot and never expose its token in frontend code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance Pay Merchant API (optional until merchant credentials are configured)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_CERTIFICATE_SN=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com

# TRON/TRC20 automatic verification
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_RECEIVING_ADDRESS=
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRC20_MIN_CONFIRMATIONS=19

# Keep false until payment verification has been tested with production credentials.
PAYMENT_AUTO_VERIFY=false

# Delivery email + inventory encryption
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=orders@YOUR-DOMAIN.example
# 32-byte AES key as 64 hex chars: openssl rand -hex 32
DELIVERY_ENCRYPTION_KEY=
